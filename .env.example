# ==========================================================
# SDG Align Configuration Example
# ==========================================================
# EXAMPLE values only. Copy to ".env" and edit. Never commit ".env".
#
# SAFE BY DEFAULT: with this file as-is the server makes ZERO paid or
# quota-limited calls. Embeddings run locally (free, offline). The
# LLM and planner stay OFF until you opt in (section 2 below).
#
# What costs money or uses quota (all of it needs NETWORK_CALLS_PERMITTED=true):
#   PAID / QUOTA-LIMITED : LLM_PROVIDER and PLANNER_LLM_PROVIDER
#                          (openrouter, gemini, groq - every /run-query makes
#                          up to MAX_LLM_CALLS_PER_REQUEST of these calls)
#   QUOTA-LIMITED        : EMBEDDING_PROVIDER=huggingface or gemini
#                          (hosted APIs; also needs a different index - see below)
#   FREE, NO NETWORK     : EMBEDDING_PROVIDER=local (default), the tests,
#                          retrieval, the evaluation tools
# ==========================================================

# ----------------------------------------------------------
# 1. Network opt-in  (default: false = no paid or hosted call is possible)
# ----------------------------------------------------------
# A hosted provider configured while this is not "true" stops the server at
# startup with NETWORK_CALLS_DISABLED. Only the exact word "true" enables it.
NETWORK_CALLS_PERMITTED=false

# ----------------------------------------------------------
# 2. LLM + planner  (PAID / QUOTA-LIMITED - opt-in)
# ----------------------------------------------------------
# To enable: set NETWORK_CALLS_PERMITTED=true above, uncomment ONE block, and
# export the matching key in your shell or put it in this file (keys are never
# committed). Without a planner the server can start, but /run-query cannot
# answer (it returns an execution failure).

# ---------- OpenRouter ----------
# LLM_PROVIDER=openrouter
# LLM_PROVIDER_CREDENTIAL_REF=env:OPENROUTER_API_KEY
# LLM_PROVIDER_EXTRA_MODEL=meta-llama/llama-3.3-70b-instruct
# PLANNER_LLM_PROVIDER=openrouter
# PLANNER_LLM_PROVIDER_CREDENTIAL_REF=env:OPENROUTER_API_KEY
# DEFAULT_PLANNER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_API_KEY=

# ---------- Gemini (API key) ----------
# LLM_PROVIDER=gemini
# LLM_PROVIDER_CREDENTIAL_REF=env:GEMINI_API_KEY
# LLM_PROVIDER_EXTRA_MODEL=gemini-3.5-flash-lite
# PLANNER_LLM_PROVIDER=gemini
# PLANNER_LLM_PROVIDER_CREDENTIAL_REF=env:GEMINI_API_KEY
# DEFAULT_PLANNER_MODEL_NAME=gemini-3.5-flash-lite
# GEMINI_API_KEY=

# ---------- Groq ----------
# LLM_PROVIDER=groq
# LLM_PROVIDER_CREDENTIAL_REF=env:GROQ_API_KEY
# LLM_PROVIDER_EXTRA_MODEL=llama-3.3-70b-versatile
# PLANNER_LLM_PROVIDER=groq
# PLANNER_LLM_PROVIDER_CREDENTIAL_REF=env:GROQ_API_KEY
# DEFAULT_PLANNER_MODEL_NAME=llama-3.3-70b-versatile
# GROQ_API_KEY=

# Hard cap on LLM calls (planner + answer, retries included) for ONE request.
# Integer >= 1; unset, blank or invalid means 6. A normal request needs 3.
MAX_LLM_CALLS_PER_REQUEST=6

# ----------------------------------------------------------
# 3. Embeddings  (FREE - local sentence-transformers on CPU, no network)
# ----------------------------------------------------------
# This MUST match the vector index on disk (the shipped build used
# local / BAAI/bge-small-en-v1.5 / v1.5). A mismatch stops the server at
# startup with INDEX_EMBEDDING_MODEL_MISMATCH. Needs requirements-local.txt.
EMBEDDING_PROVIDER=local
EMBEDDING_PROVIDER_EXTRA_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER_EXTRA_MODEL_VERSION=v1.5

# The model is read from the local Hugging Face cache ONLY (offline mode is
# forced in code). A model that is not cached stops the server at startup
# with a clear error. To place it in the cache once, run a single time with:
# ALLOW_MODEL_DOWNLOAD=true

# Hosted alternatives (QUOTA-LIMITED, need NETWORK_CALLS_PERMITTED=true AND an
# index rebuilt with that provider - the shipped index was built with "local"):
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_PROVIDER_CREDENTIAL_REF=env:HF_API_KEY
# HF_API_KEY=
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_PROVIDER_CREDENTIAL_REF=env:GEMINI_API_KEY

# ----------------------------------------------------------
# 4. Backend
# ----------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
# Longer queries get HTTP 422. Default 4000.
MAX_QUERY_CHARS=4000
# One allowed browser origin (CORS). Default http://localhost:5173
# FRONTEND_ORIGIN=http://localhost:5173

# Retrieval used by the served backend: hybrid (BM25 + dense, the measured
# best; default) or dense (baseline). Any other value stops the server at
# startup, in every configuration.
RETRIEVAL_MODE=hybrid

# Optional multi-agent answering path (Google ADK; needs requirements-agents.txt
# and the Gemini provider). Off unless this is exactly "true".
# AGENTS_ENABLED=false

# ----------------------------------------------------------
# Startup checks (always on)
# ----------------------------------------------------------
# The server refuses to start (clear error, non-zero exit) if the manifest,
# chunks or vector index under data/proposals/ are missing or empty, if the
# index was built by a different embedding model than configured, or if the
# embedding model is not in the local cache.

# ---------- LLM call limits (free tier Gemini = 20 requests/day per project) ----------
# MAX_LLM_CALLS_PER_REQUEST=2     # per-request cap, retries included (default 6)
# DAILY_LLM_CALL_CAP=10           # per-process daily cap, 0..18 (default 10); 0 = retrieval only
# LLM_PACE_RPM=12                 # eval runs: start at most 12 calls/minute (free-tier limit is 15). 0/unset = no pacing
