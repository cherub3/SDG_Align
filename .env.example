# ==========================================================
# SDG Align Configuration Example
# ==========================================================
# This file contains EXAMPLE values only.
# Copy this file to ".env" and replace the placeholder values
# with your real API keys before running the project.
# Never commit your real ".env" file to GitHub.
# ==========================================================

# ----------------------------------------------------------
# Network Configuration
# ----------------------------------------------------------
NETWORK_CALLS_PERMITTED=true

# ==========================================================
# LLM Provider Configuration
# ==========================================================

# ---------- Default (Recommended): OpenRouter ----------
LLM_PROVIDER=openrouter
LLM_PROVIDER_CREDENTIAL_REF=env:OPENROUTER_API_KEY
LLM_PROVIDER_EXTRA_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------- Gemini Alternative ----------
# LLM_PROVIDER=gemini
# LLM_PROVIDER_CREDENTIAL_REF=env:GEMINI_API_KEY
# LLM_PROVIDER_EXTRA_MODEL=gemini-2.5-flash

# ---------- Groq Alternative ----------
# LLM_PROVIDER=groq
# LLM_PROVIDER_CREDENTIAL_REF=env:GROQ_API_KEY
# LLM_PROVIDER_EXTRA_MODEL=llama-3.3-70b-versatile


# ==========================================================
# Planner Provider Configuration
# ==========================================================

# ---------- Default (Recommended): OpenRouter ----------
PLANNER_LLM_PROVIDER=openrouter
PLANNER_LLM_PROVIDER_CREDENTIAL_REF=env:OPENROUTER_API_KEY
DEFAULT_PLANNER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# ---------- Gemini Alternative ----------
# PLANNER_LLM_PROVIDER=gemini
# PLANNER_LLM_PROVIDER_CREDENTIAL_REF=env:GEMINI_API_KEY
# DEFAULT_PLANNER_MODEL_NAME=gemini-2.0-flash

# ---------- Groq Alternative ----------
# PLANNER_LLM_PROVIDER=groq
# PLANNER_LLM_PROVIDER_CREDENTIAL_REF=env:GROQ_API_KEY
# DEFAULT_PLANNER_MODEL_NAME=llama-3.3-70b-versatile


# ==========================================================
# Embedding Provider Configuration
# ==========================================================

# ---------- Default (Recommended): Hugging Face ----------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_PROVIDER_CREDENTIAL_REF=env:HF_API_KEY
EMBEDDING_PROVIDER_EXTRA_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER_EXTRA_MODEL_VERSION=v1.5

# ---------- Gemini Alternative ----------
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_PROVIDER_CREDENTIAL_REF=env:GEMINI_API_KEY
# EMBEDDING_PROVIDER_EXTRA_MODEL_NAME=text-embedding-004
# EMBEDDING_PROVIDER_EXTRA_MODEL_VERSION=004


# ==========================================================
# Index Backend
# ==========================================================
# Leave commented unless an Index Provider registration
# is implemented in the composition root.
#
# INDEX_BACKEND=faiss


# ==========================================================
# API Keys
# ==========================================================
# Replace the placeholder values below with your own keys
# after copying this file to ".env".
# Never commit your real ".env" file.

OPENROUTER_API_KEY=your_openrouter_api_key_here
HF_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here


# ==========================================================
# Backend
# ==========================================================

REQUEST_TIMEOUT_SECONDS=60